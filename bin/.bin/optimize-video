#!/usr/bin/env bash

# Compress significantly a video, while still keeping a good quality.

output="compressed.$1.mp4"
if [ ! -z "$2" ]; then
  output="$2"

  # Add extension if necessary.
  [[ ! $output == *.* ]] && output="$output.mp4"
fi

# X265 CRF
# 22: good
# 26: balanced
# (28: default)
# 30: not good but still ok

# `-tag:v hvc1` ensures compatibility with macOS Finder and Quick Look.

echo "Compressing '$1'..."

ffmpeg -hide_banner -loglevel error -i "$1" -c:v libx265 -preset medium -crf 22 -tag:v hvc1 -c:a aac -b:a 192k -f mp4 "$output"

echo 'Done.'
